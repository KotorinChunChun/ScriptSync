{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "読みあわせ",
  "version": "0.0.3",
  "identifier": "jp.kotorinchunchun.scriptsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "読みあわせ (ScriptSync)",
        "width": 1280,
        "height": 720,
        "visible": false,
        "minWidth": 960,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "読みあわせ",
  "version": "0.0.5",
  "identifier": "jp.kotorinchunchun.scriptsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "読みあわせ (ScriptSync)",
        "width": 1280,
        "height": 720,
        "visible": false,
        "minWidth": 960,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "scriptsync"
        ],
        "name": "ScriptSync Project",
        "description": "読みあわせプロジェクト",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}

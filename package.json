{
  "name": "scriptsync",
  "private": true,
  "license": "MIT",
  "version": "0.0.6",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "presentation:dev": "node tools/presentation/server.mjs",
    "test:presentation": "node --test tools/presentation/presentation.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:static": "node dev/scripts/check-static.mjs",
    "check:powershell": "pwsh -NoProfile -File dev/scripts/check-powershell.ps1",
    "test:static": "node --test dev/scripts/check-static.test.mjs",
    "check:security": "node dev/scripts/check-public-source.mjs",
    "test:security": "node --test dev/scripts/check-public-source.test.mjs",
    "licenses:update": "node dev/scripts/generate-third-party.mjs",
    "licenses:check": "node dev/scripts/generate-third-party.mjs --check",
    "verify": "pwsh -NoProfile -File dev/scripts/Test-ScriptSync.ps1",
    "verify:native": "pwsh -NoProfile -File dev/scripts/Test-ScriptSync.ps1 -Native",
    "test:native": "node dev/scripts/test-native.mjs",
    "check:rust-advisories": "node dev/scripts/check-rust-advisories.mjs",
    "tauri": "tauri",
    "release:msix": "pwsh -NoProfile -File dev/scripts/build-msix.ps1",
    "release:plan": "pwsh -NoProfile -File dev/scripts/publish-ScriptSync.ps1 -Mode Plan",
    "services:start": "node tools/services/server.mjs",
    "test:services": "node --test tools/services/server.test.mjs",
    "build:web": "tsc && vite build --mode web --base=/test/scriptsync/ --outDir dist-web && node dev/scripts/prepare-web.mjs",
    "test:web": "vitest run tests/ui/webBackend.test.ts",
    "test:web:e2e": "node dev/scripts/test-web.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@zip.js/zip.js": "2.24.0",
    "fflate": "0.8.3",
    "qrcode-generator": "^2.0.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}

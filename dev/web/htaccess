DirectoryIndex index.html
Options -Indexes
AddType application/wasm .wasm
AddType text/javascript .mjs .js
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' http: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
<FilesMatch "^(index\.html|help\.html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
